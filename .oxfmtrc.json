{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "bracketSameLine": true,
  "trailingComma": "es5",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "functions": ["cva"]
  },
  "ignorePatterns": [
    "node_modules",
    "tools/oxlint/anti-slop/**",
    ".pnp",
    ".pnp.js",
    "dist",
    "build",
    ".next",
    ".turbo",
    ".expo",
    "android",
    "ios",
    "coverage",
    "*.lcov",
    "bun.lockb",
    "*.tsbuildinfo",
    ".project.inlang/**",
    ".agents/**",
    ".devenv/",
    "uniwind-types.d.ts",
    "fdroid/metadata/"
  ]
}
